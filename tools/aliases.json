{
  "// Curated alias table: exact feed name -> EPG id. Consulted before name matching.": "",
  "// Keys are the name exactly as it goes into esencial.m3u (leading/trailing spaces trimmed).": "",
  "// Every value was verified with grep against the default country files; never guess one.": "",
  "// Why this exists: plain name matching picks the wrong country for some names.": "",
  "// 'TyC Sports' normalizes to 'tyc sports', which exists in gt, co, cr, ec, pa, py and ar.": "",
  "// Without an alias the first country in the list (gt) wins and the grid lies.": "",

  "// DSports is the Latin American DIRECTV Sports feed, and the guide publishes it twice:": "",
  "// DIRECTVSports.uy carries only placeholder rows (0 programmes), while .ec": "",
  "// carries the same signal with real listings (108 / 60 / 53 rows for main, 2 and +). So every": "",
  "// DSports variant pins to the .ec id: the country suffix is a source label, not a schedule.": "",
  "// DIRECTVSportsFight.ec exists but is all placeholders, and the feed has no Fight channel.": "",
  "DSports [Opc. 1]": "DIRECTVSports.ec",
  "DSports  [Opc. 2]": "DIRECTVSports.ec",
  "DSports  [Opc. 3]": "DIRECTVSports.ec",
  "DSports  [Opc. 4]": "DIRECTVSports.ec",
  "DSports (ECU) [Opc. 5]": "DIRECTVSports.ec",
  "DSports +": "DIRECTVSports+.ec",
  "DSports +  [Opc.2]": "DIRECTVSports+.ec",
  "DSports 2": "DIRECTVSports2.ec",
  "DSports 2  [Opc.2]": "DIRECTVSports2.ec",
  "DSports 2  [Opc.3]": "DIRECTVSports2.ec",

  "// TyC Sports is Argentine. ar publishes only TyCSports.ar (101 programmes) and TyCSports2.ar": "",
  "// (15), so the plain entries and 'AR' are mirrors of one signal and share its grid.": "",
  "// '(Internacional)' is not a mirror: the international distribution is its own feed, and the": "",
  "// us source publishes it as TyCSportsInt.us (108 programmes, 'Futbol Argentino Primera": "",
  "// Division'). Pinning it to .ar showed the domestic schedule on a channel that carries it": "",
  "// delayed, which is how the hub lost the match. Needs --include-us.": "",
  "TyC Sports": "TyCSports.ar",
  "TyC Sports [Opc.2]": "TyCSports.ar",
  "TyC Sports [Opc.3]": "TyCSports.ar",
  "TyC Sports AR": "TyCSports.ar",
  "TyC Sports (Internacional)": "TyCSportsInt.us",
  "TyC Sports SD (Internacional)": "TyCSportsInt.us",

  "// Sky Sports LaLiga is the Mexican retransmission of the Spanish LaLiga channel. No LaLiga": "",
  "// id exists under mx; es publishes the feed itself. M+LaLigaTV.es carries 191 programmes with": "",
  "// the fixture in the title ('LALIGA EA SPORTS (T26/27): Villarreal CF - Elche CF'), which is": "",
  "// what the guide and the sports matcher read.": "",
  "// NOT pinned: DAZNLaLiga.es looks right by name and has 0 programmes when scanned strictly;": "",
  "// LaLigaTVBAR.es repeats the channel name in every title, so it matches no fixture.": "",
  "Sky Sports LaLiga": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.2]": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.3]": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.4]": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.5]": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.6]": "M+LaLigaTV.es",
  "Sky Sports LaLiga [Opc.7]": "M+LaLigaTV.es",

  "// Sky Sports F1: DAZNF1.es is the Spanish F1 channel, 117 programmes, rounds named in the": "",
  "// title ('Mundial F1 - GP de Paises Bajos : Carrera'). MovistarF1.es is the same sport with a": "",
  "// smaller grid, so the DAZN one is used.": "",
  "Sky Sports F1": "DAZNF1.es",

  "// Movistar Deportes is Spanish; M+Deportes.es is its grid (111 programmes: Euroliga, ATP,": "",
  "// cycling). The feed names carry no country, so the country comes from the id.": "",
  "Movistar Deportes": "M+Deportes.es",
  "Movistar Deportes[Opc.2]": "M+Deportes.es",
  "Movistar Deportes[Opc.3]": "M+Deportes.es",

  "// Telemundo Deportes Ahora (Internacional): the us source carries it as": "",
  "// TelemundoDeportesAhora.peacocktv (75 programmes). The suffix is a provider label, not a": "",
  "// country, so the id only resolves while the us file is downloaded.": "",
  "Telemundo Deportes Ahora (Internacional)": "TelemundoDeportesAhora.peacocktv",
  "Telemundo Deportes Ahora (Internacional)[1080p]": "TelemundoDeportesAhora.peacocktv",
  "Telemundo Deportes Ahora (Internacional)[720p]": "TelemundoDeportesAhora.peacocktv",

  "// TNT Sports: only the Argentine id exists in the default set (ar publishes TNTSports.ar).": "",
  "// NOT pinned: 'TNT Sports Premium*' is a different premium signal; no id for it exists here,": "",
  "// and pointing it at the plain TNT Sports grid would show the wrong programmes.": "",
  "TNT Sports": "TNTSports.ar",
  "TNT Sports[Opc.2]": "TNTSports.ar",
  "TNT Sports[Opc.3]": "TNTSports.ar",

  "// Claro Sports: only the Uruguayan id exists (uy publishes CLAROSPORTS). The unqualified feed": "",
  "// entries carry no country, so the single available Claro Sports grid is used.": "",
  "// NOT pinned: 'Claro Sports (México)' claims Mexico and no Mexican Claro Sports id exists;": "",
  "// ClaroTV.pa is a general Panamanian channel, not Claro Sports.": "",
  "Claro Sports SD": "CLAROSPORTS.uy",
  "Claro Sports SD (opc.2)": "CLAROSPORTS.uy",

  "// Blocked, not unresolved: the plain 'FOX' entries are the Latin American sports feeds. The": "",
  "// only grid that matches the name is the US FOX4K event feed, so plain matching would put": "",
  "// MLB pregame on a channel that never carries it. One block covers the mirror variants too,": "",
  "// because '[Opc.2]' is stripped before the table is consulted again.": "",
  "FOX": "!",

  "// NOT pinned, by decision: beIN Sports (EN/ES) is in the us file but the grid is filler -": "",
  "// beINSports.us runs 'Paid Programming' and beINSportsEnEspanol.us runs 'Programa pagado'.": "",
  "// A guide of filler is worse than a gap, because a gap is visibly missing while filler lies.": "",
  "// NOT pinned, by decision: beINSPORTS3..8.us are mostly 'SIGN OFF'.": "",
  "// NOT pinned, by decision: 'UFC (EE.UU.) [EN]' would only reach UFCNetwork.co, the Latin": "",
  "// American UFC Network channel, which is a different regional signal with its own schedule.": "",
  "// NOT pinned, by decision: Tigo Sports (BO/PY) has only TigoSports.py, a different country.": "",
  "// NOT pinned, by decision: Azteca Deportes Network has no sports id in es or us;": "",
  "// AztecaInternacional.us is the general entertainment channel.": "",

  "// Win+ is Win Sports' second Colombian channel; co publishes WinSports+.co.": "",
  "Win+ HD": "WinSports+.co",
  "Win+ HD [Opc.2]": "WinSports+.co",
  "Win+ HD [Opc.3]": "WinSports+.co"
}
